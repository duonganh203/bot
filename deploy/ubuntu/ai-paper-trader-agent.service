[Unit]
Description=Generate one AI paper trade signal
Wants=network-online.target
After=network-online.target ai-paper-trader.service

[Service]
Type=oneshot
User=trade-agent
Group=trade-agent
WorkingDirectory=/home/trade-agent/paper-runner
Environment=HOME=/home/trade-agent
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/ai-paper-trader/runner/run.py
UMask=0077
Nice=10
TimeoutStartSec=10min
KillMode=control-group
# Keep the working per-user Codex sandbox/AppArmor setup. No root execution or
# global user-namespace bypass is needed. Do not add hardening that breaks bwrap.
