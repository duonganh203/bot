[Unit]
Description=Separate deterministic control paper portfolio
After=network.target

[Service]
Type=simple
User=paper-trader-shadow
Group=paper-trader-shadow
WorkingDirectory=/opt/ai-paper-trader
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=DATABASE_PATH=/var/lib/ai-paper-trader-shadow/paper.sqlite
Environment=API_TOKEN=
Environment=LOG_LEVEL=info
ExecStart=/usr/bin/node /opt/ai-paper-trader/dist/app/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ai-paper-trader-shadow

[Install]
WantedBy=multi-user.target
