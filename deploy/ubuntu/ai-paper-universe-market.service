[Unit]
Description=Shared five-coin market input for universe comparison
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=trade-agent
Group=trade-agent
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/ai-paper-universe/runner/market_snapshot.py --directory /home/trade-agent/paper-universe/market --symbols BTCUSDT ETHUSDT SOLUSDT BNBUSDT XRPUSDT
UMask=0077
TimeoutStartSec=90s
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/trade-agent/paper-universe/market
PrivateTmp=true
